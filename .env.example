# Скопируй в .env и заполни
PORT=3000
PUBLIC_URL=http://localhost:3000

# Бренд и Instagram (без @)
BRAND=ITTY
INSTAGRAM=itty.company

# Время по Киеву: старт 18 октября, длится месяц
START_AT=2026-10-18T00:00:00+03:00
END_AT=2026-11-18T00:00:00+03:00

# Призы за 1..5 места через |
PRIZES=Головний приз|Приз за 2 місце|Приз за 3 місце|Приз за 4 місце|Приз за 5 місце
WINNERS=5

# Цена одного шанса в центах ($1 = 100)
PRICE_CENTS=100
CURRENCY=usd

# Админка: /admin
ADMIN_PASSWORD=поменяй-меня-на-длинный-пароль
# Любая длинная случайная строка
SESSION_SECRET=поменяй-меня-на-случайную-строку

# demo — шансы начисляются без оплаты (тест). stripe — реальная оплата.
PAYMENT_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 0 — запретить регистрацию до старта. По умолчанию регистрация до старта открыта (покупка шансов — только со старта)
PREREGISTRATION=1

# Секрет для живых Google Таблиц (=IMPORTDATA). Любая длинная случайная строка.
# Формулы появятся в админке в блоке «Таблицы».
EXPORT_KEY=
